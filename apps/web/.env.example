# Browser requests use /api-proxy/v1/... on the Next.js origin. The server-side
# Route Handler forwards them to ${API_PROXY_TARGET}/api/v1/....
NEXT_PUBLIC_API_URL=/api-proxy
# Absolute upstream origin only; do not include /api or another path.
API_PROXY_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Agrovix AgOS
NEXT_PUBLIC_APP_ENV=development
