{
  "name": "@agrovix/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*expo/virtual/)"
    ]
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf node_modules .expo"
  },
  "dependencies": {
    "@agrovix/types": "workspace:*",
    "@agrovix/utils": "workspace:*",
    "@agrovix/validation": "workspace:*",
    "@babel/runtime": "^7.20.0",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.14",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.15",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@react-native/metro-config": "0.86.3",
    "@types/jest": "29",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "babel-preset-expo": "~57.0.9",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  }
}
