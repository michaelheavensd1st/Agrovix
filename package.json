{
  "name": "agrovix-agos",
  "version": "0.1.0",
  "private": true,
  "description": "Agrovix AgOS — Enterprise Agricultural Operating System (monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev/start.sh",
    "dev:workspace": "turbo run dev --parallel",
    "dev:start": "bash scripts/dev/start.sh",
    "dev:check": "bash scripts/dev/check.sh",
    "dev:status": "bash scripts/dev/status.sh",
    "dev:stop": "bash scripts/dev/stop.sh",
    "dev:logs": "bash scripts/dev/logs.sh",
    "dev:migrate": "bash scripts/dev/migrate.sh",
    "dev:bootstrap-uat": "bash scripts/dev/bootstrap-uat.sh",
    "dev:reset": "bash scripts/dev/reset.sh",
    "dev:web": "turbo run dev --filter=@agrovix/web",
    "dev:mobile": "turbo run dev --filter=@agrovix/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8.57",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "publicHoistPattern": [
      "@types/*"
    ]
  }
}
